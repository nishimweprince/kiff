# Resend: https://resend.com/api-keys
RESEND_API_KEY=
# Where new applications are sent (comma-separate for several addresses)
APPLICATION_TO_EMAIL=hello@1819twenty.com
# Sender for both emails. The domain must be verified in Resend.
# e.g. "KIFF <hello@kigalifashionfestival.com>"
RESEND_FROM_EMAIL=

# Cloudinary: Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: override the application deadline (ISO date) for testing the closed state
# APPLICATIONS_CLOSE_AT=2027-02-01T00:00:00+02:00
